{
  "authority": {
    "base_contract_version": "2.0.0",
    "evidence_mode_extension_source": "AtlasReaper311/atlas-infra:policy/public-interface-evidence-mode-extension-v1.json",
    "evidence_mode_extension_version": "1.0.0",
    "footer_extension_source": "AtlasReaper311/atlas-infra:policy/public-interface-footer-extension-v1.json",
    "footer_extension_version": "1.0.0",
    "foundation_extension_source": "AtlasReaper311/atlas-infra:policy/public-interface-foundation-extension-v1.json",
    "foundation_extension_version": "1.0.0"
  },
  "breadcrumb_navigation": {
    "accessible_name_required": true,
    "applies_to": "hierarchical-human-facing-routes",
    "current_page": [
      "text",
      "aria-current=page"
    ],
    "homepage_forbidden": true,
    "landmark": "nav",
    "machine_surfaces_excluded": true,
    "ordered_list_required": true,
    "purpose_specific_opt_out_allowed": true,
    "required": false,
    "role": "breadcrumb-navigation",
    "selector": ".atlas-breadcrumbs"
  },
  "dense_data_overflow": {
    "applies_to": [
      "table",
      "code",
      "preformatted-output",
      "dense-data-region"
    ],
    "content_and_rendering_owner": "consumer",
    "extends_role": "table-wrapper",
    "overflow_detection_owner": "consumer",
    "overflow_state_attribute": "data-overflow=true",
    "selector": ".atlas-table-wrap",
    "when_not_overflowing": {
      "unnecessary_tab_stop_forbidden": true
    },
    "when_overflowing": {
      "accessible_name_required": true,
      "keyboard_focus_required": true,
      "local_horizontal_scroll_required": true,
      "tabindex": "0",
      "visible_focus_required": true
    }
  },
  "distribution": {
    "consumer_adoption_requires_separate_pull_request": true,
    "consumer_rollout_requires_separate_approval": true,
    "remote_runtime_dependency_forbidden": true,
    "repository_local_assets_required": true,
    "shared_runtime_javascript_forbidden": true
  },
  "evidence": {
    "blocking_viewports_px": [
      320,
      375,
      768,
      1024,
      1440
    ],
    "reporting_only_changes_content_width": false,
    "reporting_only_changes_layout_tokens": false,
    "reporting_only_is_breakpoint": false,
    "reporting_only_is_budget": false,
    "reporting_only_viewports_px": [
      1920
    ]
  },
  "evidence_mode_authority": {
    "colour_must_not_be_the_only_signal": true,
    "directory_and_destination_vocabulary_must_agree": true,
    "directory_data_modes": [
      "Live",
      "Replay",
      "Generated",
      "Simulated"
    ],
    "evidence_bearing_operational_surfaces_only": true,
    "fallback_mode_must_remain_visible_across_primary_state_metrics_tables_and_charts": true,
    "generated_output_definition": "Output produced by the product itself that does not stand in for a measurement or assert the condition of a real system.",
    "generated_output_is_evidence": false,
    "generated_product_output_may_retain_product_specific_palette": true,
    "machine_readable_mode_required": true,
    "maturity_is_separate_from_evidence_mode": true,
    "mode_attribute": "data-evidence-mode",
    "mode_label_selector": ".atlas-evidence-mode",
    "modes": {
      "measured": {
        "definition": "Current evidence obtained from a live bounded source.",
        "label": "Measured",
        "numeral_treatment": "plain-measured-value",
        "semantic_runtime_hue_permitted": true,
        "source_and_age_required": true
      },
      "not-applicable-unscored": {
        "definition": "The measure does not apply or has been excluded from the scoring denominator.",
        "label": "Not applicable / unscored",
        "numeral_treatment": "not-applicable-or-unscored-label",
        "semantic_runtime_hue_permitted": false,
        "source_and_age_required": false
      },
      "recorded-replay": {
        "definition": "Captured evidence played back without claiming to be the current condition.",
        "label": "Recorded replay",
        "numeral_treatment": "recorded-value-with-replay-marker",
        "semantic_runtime_hue_permitted": false,
        "source_and_age_required": true
      },
      "simulated": {
        "definition": "Synthetic values standing in for measurements that were not taken.",
        "label": "Simulated",
        "numeral_treatment": "synthetic-value-with-simulation-marker",
        "semantic_runtime_hue_permitted": false,
        "source_and_age_required": false
      },
      "stale-measured": {
        "definition": "Previously measured evidence retained after its accepted freshness window.",
        "label": "Stale measured",
        "numeral_treatment": "measured-value-with-stale-marker",
        "semantic_runtime_hue_permitted": true,
        "source_and_age_required": true
      },
      "unavailable": {
        "definition": "The expected evidence source could not provide evidence.",
        "label": "Unavailable",
        "numeral_treatment": "em-dash",
        "semantic_runtime_hue_permitted": false,
        "source_and_age_required": false
      },
      "unknown": {
        "definition": "The evidence source, meaning, or state cannot be determined from the available information.",
        "label": "Unknown",
        "numeral_treatment": "em-dash",
        "semantic_runtime_hue_permitted": false,
        "source_and_age_required": false
      }
    },
    "neutral_surface_modes": [
      "recorded-replay",
      "simulated",
      "unavailable",
      "unknown",
      "not-applicable-unscored"
    ],
    "ownership": {
      "consumer_mode_selection_owner": true,
      "consumer_runtime_state_owner": true,
      "consumer_source_metadata_owner": true,
      "implementation_owner": "AtlasReaper311/atlas-interface-kit",
      "shared_runtime_javascript_forbidden": true
    },
    "redundant_signals": [
      "visible-text-label",
      "surface-treatment",
      "numeral-convention"
    ],
    "role": "evidence-mode",
    "runtime_state_attribute": "data-runtime-state",
    "runtime_state_is_separate_from_evidence_mode": true,
    "semantic_runtime_hue_modes": [
      "measured",
      "stale-measured"
    ],
    "surface_selector": ".atlas-evidence-surface",
    "value_selector": ".atlas-evidence-value",
    "visible_mode_label_required": true,
    "zero_may_not_represent": [
      "unavailable",
      "unknown",
      "not-applicable-unscored"
    ]
  },
  "footer_authority": {
    "accessible_name_required_when_multiple": true,
    "behaviour": {
      "atlas_owned_html_same_tab_required": true,
      "external_links_new_tab_required": true,
      "external_links_rel": "noopener noreferrer",
      "fixed_bottom_navigation_clearance_required": true,
      "global_navigation_duplication_forbidden": true,
      "minimum_touch_target_px": 44,
      "mobile_wrap_required": true,
      "purpose_specific_labels_required": true,
      "reduced_motion_required": true,
      "visible_focus_required": true
    },
    "empty_footer_forbidden": true,
    "empty_slots_forbidden": true,
    "ownership": {
      "article_sequence_owner": "AtlasReaper311/atlas-scheduler",
      "consumer_content_owner": true,
      "implementation_owner": "AtlasReaper311/atlas-interface-kit",
      "shared_runtime_javascript_forbidden": true
    },
    "role": "footer",
    "selector": ".atlas-footer",
    "semantic_element": "footer",
    "single_primary_footer_required": true,
    "slots": {
      "context": {
        "content_owner": "consumer",
        "required_globally": false,
        "selector": ".atlas-footer__context"
      },
      "estate_escape": {
        "content_owner": "consumer",
        "required_globally": true,
        "selector": ".atlas-footer__escape"
      },
      "evidence": {
        "content_owner": "consumer",
        "required_globally": false,
        "selector": ".atlas-footer__evidence"
      },
      "identity": {
        "content_owner": "consumer",
        "required_globally": true,
        "selector": ".atlas-footer__identity"
      },
      "sequence": {
        "article_owner": "AtlasReaper311/atlas-scheduler",
        "content_owner": "consumer-or-publisher",
        "required_globally": false,
        "selector": ".atlas-footer__sequence"
      }
    },
    "variants": {
      "editorial": {
        "forbidden_slots": [],
        "optional_slots": [
          "context",
          "evidence"
        ],
        "required_slots": [
          "identity",
          "sequence",
          "estate_escape"
        ],
        "selector": ".atlas-footer--editorial"
      },
      "estate": {
        "forbidden_slots": [
          "sequence"
        ],
        "optional_slots": [
          "context",
          "evidence"
        ],
        "required_slots": [
          "identity",
          "estate_escape"
        ],
        "selector": ".atlas-footer--estate"
      },
      "product": {
        "forbidden_slots": [
          "sequence"
        ],
        "optional_slots": [
          "context",
          "evidence"
        ],
        "required_slots": [
          "identity",
          "estate_escape"
        ],
        "selector": ".atlas-footer--product"
      },
      "tool": {
        "forbidden_slots": [
          "sequence"
        ],
        "optional_slots": [
          "evidence"
        ],
        "required_slots": [
          "identity",
          "context",
          "estate_escape"
        ],
        "selector": ".atlas-footer--tool"
      }
    }
  },
  "schema_version": "atlas-interface-kit/semantics/v1",
  "status_announcement": {
    "announce_on": [
      "meaningful-user-visible-state-transition"
    ],
    "blocking_failure_semantics": {
      "role": "alert",
      "use": "immediate-blocking-failure-only"
    },
    "default_semantics": {
      "aria_atomic": "true",
      "aria_live": "polite",
      "role": "status"
    },
    "global_header_status_remains_aria_live_off": true,
    "required": false,
    "role": "status-announcement",
    "selector": ".atlas-status-announcement",
    "shared_runtime_javascript_forbidden": true,
    "silent_on": [
      "initial-poll",
      "unchanged-poll",
      "routine-refresh"
    ],
    "trigger_owner": "consumer",
    "wording_owner": "consumer"
  },
  "version": "0.5.0"
}
